{
    "name": "fun_ofdm",
    "build": {
        "dockerfile": "Dockerfile",
        // tools/bootstrap/, which the Dockerfile copies bootstrap.sh from, as
        // the build context named "bootstrap". An absolute path: Docker would
        // resolve a relative one from wherever the build runs, not from here.
        "options": [
            "--build-context",
            "bootstrap=${localWorkspaceFolder}/tools/bootstrap"
        ]
    },
    "runArgs": [
        // No seccomp filter, so ThreadSanitizer (`--config=tsan`) can start.
        // On a kernel with high mmap randomization, TSan re-runs itself with
        // randomization off, through personality(), which Docker's default
        // seccomp profile blocks. This container is only for development, so
        // filtering syscalls isn't worth losing TSan for.
        "--security-opt", "seccomp=unconfined"
    ],

    "mounts": [
        // Claude Code state (login, settings, sessions), kept across rebuilds
        "source=fun_ofdm-claude-config,target=/home/ubuntu/.claude,type=volume",
        // GitHub CLI login, kept across rebuilds
        "source=fun_ofdm-gh-config,target=/home/ubuntu/.config/gh,type=volume",
        // Bazel output base and caches, kept across rebuilds so builds don't
        // start cold and the bazel-* symlinks keep working
        "source=fun_ofdm-bazel-cache,target=/home/ubuntu/.cache/bazel,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude",
        // Where `uv sync` puts the Python tools' venv. By default that's .venv
        // in the checkout, which the host shares, but a venv only works with
        // the Python it was made with. So the container keeps its own here,
        // and the host keeps .venv.
        "UV_PROJECT_ENVIRONMENT": "/home/ubuntu/.venv"
    },

    "remoteUser": "ubuntu",

    // Each command runs in parallel with the others.
    "postCreateCommand": {
        // Enable the pre-commit hook and have git blame skip the reformat
        // commit. This writes to .git/config, so it applies to the host's
        // checkout too. One command, since two git configs at once would
        // race for .git/config's lock.
        "git": "git config core.hooksPath tools/githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs",
        // Install Python and the Python tools' packages, from uv.lock.
        "uv": "uv sync"
    },

    // git authenticates to GitHub through the GitHub CLI; point out a missing login
    "postStartCommand": "gh auth status --hostname github.com >/dev/null 2>&1 || echo \"Not logged in to GitHub, so git push/pull won't work. Run 'gh auth login' to log in.\"",

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "astral-sh.ty",
                "BazelBuild.vscode-bazel",
                "charliermarsh.ruff",
                "GitHub.vscode-github-actions",
                "ms-python.python",
                "ms-vscode.cpptools"
            ],
            "settings": {
                // The Python tools' environment, which `uv sync` makes outside
                // the checkout (UV_PROJECT_ENVIRONMENT, above).
                "python.defaultInterpreterPath": "/home/ubuntu/.venv/bin/python",
                // IntelliSense uses the same clang, sysroot and external repos
                // as a Bazel build for the container's architecture. They're
                // all in Bazel's output base, so run `bazel build //...` once
                // to download them.
                "C_Cpp.default.compilerPath": "/home/ubuntu/.cache/bazel/fun_ofdm/external/toolchains_llvm++llvm+llvm_toolchain_llvm/bin/clang++",
                "C_Cpp.default.compilerArgs": [
                    // Bazel's sysroot, through a link the Dockerfile makes.
                    "--sysroot=/usr/local/share/fun_ofdm/bazel_sysroot"
                ],
                "C_Cpp.default.cppStandard": "c++23",
                "C_Cpp.default.includePath": [
                    // For includes like "src/phy/frame_builder.h".
                    "${workspaceFolder}",
                    "/home/ubuntu/.cache/bazel/fun_ofdm/external/cli11+/include",
                    "/home/ubuntu/.cache/bazel/fun_ofdm/external/sse2neon+", // aarch64 only.
                    "/home/ubuntu/.cache/bazel/fun_ofdm/external/googletest+/googletest/include",
                    "/home/ubuntu/.cache/bazel/fun_ofdm/external/googletest+/googlemock/include"
                ]
            }
        }
    }
}
