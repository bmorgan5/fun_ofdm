# Never fall back to Bazel's autodetected host compiler; C++ builds use the
# LLVM toolchain registered in MODULE.bazel.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# fun_ofdm is a real-time DSP application; build optimized by default.
build --compilation_mode=opt

# Warnings are errors in our own code (src/), not in dependencies. Leaving out
# fields in a designated initializer is how a struct's defaults are used, so
# that isn't a warning.
build --per_file_copt=^src/@-Wall,-Wextra,-Werror,-Wno-missing-designated-field-initializers

# Target platforms. Every build targets an explicit platform (and sysroot),
# even the host's.
build --config=linux_x86_64
build:linux_x86_64 --platforms=//platforms:linux_x86_64
# TODO(arm64): Enable once the code builds for arm64.
# build:linux_aarch64 --platforms=//platforms:linux_aarch64

# Named configs for CI's test matrix (.github/workflows/ci.yml). opt is the
# default build, named so the matrix can list it.
build:opt --compilation_mode=opt

# Sanitizers: `bazel test //... --config=asan`. Each builds on the optimized
# build, with debug info so reports have file names and line numbers, and
# fails the test on any error it finds.
build:sanitizer --copt=-g --copt=-fno-omit-frame-pointer
# Address errors (out of bounds, use after free) and leaks.
build:asan --config=sanitizer
build:asan --copt=-fsanitize=address --linkopt=-fsanitize=address
# Undefined behaviour, such as signed overflow and misaligned pointers.
build:ubsan --config=sanitizer
build:ubsan --copt=-fsanitize=undefined --linkopt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize-recover=all
# Data races between threads. TSan needs the host kernel's
# vm.mmap_rnd_bits to be 28 or less, as on GitHub's runners, or to be allowed
# to turn off address randomization, as in the dev container, which runs
# without a seccomp profile for this. Otherwise it fails at startup with
# "incompatible memory layout".
build:tsan --config=sanitizer
build:tsan --copt=-fsanitize=thread --linkopt=-fsanitize=thread

# Print the log of a failing test.
test --test_output=errors

# Coverage: `bazel coverage //...` writes an lcov report, with line, branch
# and function coverage, to bazel-out/_coverage/_coverage_report.dat.
# `bazel run coverage` runs it and turns the report into HTML. Clang writes raw
# profiles, which Bazel only turns into lcov, with the toolchain's
# llvm-profdata and llvm-cov, when it's asked to.
coverage --combined_report=lcov
coverage --experimental_generate_llvm_lcov

try-import %workspace%/user.bazelrc
