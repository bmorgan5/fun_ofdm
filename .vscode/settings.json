{
  // Format C++ on save. The C/C++ extension's clang-format follows the
  // repo's .clang-format.
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },

  // Only index our own code. The bazel-* symlinks lead to Bazel's whole
  // output base, which is huge.
  "C_Cpp.default.browse.path": ["${workspaceFolder}/src"],
  "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
  "C_Cpp.files.exclude": {
    "**/bazel-*": true,
    "out": true
  },
  "files.watcherExclude": {
    "**/bazel-*/**": true,
    "out/**": true
  }
}
