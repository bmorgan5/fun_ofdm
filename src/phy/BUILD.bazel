load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The overview of the PHY, for the API documentation.
exports_files(["README.md"])

# The 802.11a PHY: building frames into samples and receiving frames from
# samples. Pure DSP, with no UHD dependency, so tests and benchmarks can use it
# without a USRP.
cc_library(
    name = "phy",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    # The Viterbi decoder uses SSE intrinsics.
    copts = select({
        "@platforms//cpu:x86_64": [
            "-mssse3",
            "-msse4.1",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//src:__subpackages__"],
    deps = ["//third_party:fftw3"],
)
