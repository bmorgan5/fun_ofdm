load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The overview of the PHY, for the API documentation.
exports_files(["README.md"])

# The 802.11a PHY: building frames into samples and receiving frames from
# samples. Pure DSP, with no UHD dependency, so tests and benchmarks can use it
# without a USRP.
cc_library(
    name = "phy",
    srcs = glob(
        ["*.cpp"],
        exclude = ["*_test.cpp"],
    ),
    hdrs = glob(
        ["*.h"],
        exclude = ["test_util.h"],
    ),
    # The Viterbi decoder uses SSE intrinsics.
    copts = select({
        "@platforms//cpu:x86_64": [
            "-mssse3",
            "-msse4.1",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//src:__subpackages__"],
    deps = ["//third_party:fftw3"],
)

# Helpers shared by the tests.
cc_library(
    name = "test_util",
    testonly = True,
    hdrs = ["test_util.h"],
    deps = [
        ":phy",
        "@googletest//:gtest",
    ],
)

# For the sanitizer configs (.bazelrc): the toolchain's llvm-symbolizer, so
# reports have function names and lines, and the leaks to ignore.
_SYMBOLIZER = "external_symbolizer_path=$(rootpath @llvm_toolchain_llvm//:symbolizer)"

_SANITIZER_ENV = {
    # FFTW, from the sysroot, has no frame pointers, so ASan's fast unwinder
    # stops inside it. The slow one uses the unwind tables, and gets past it to
    # the suppressed caller.
    "ASAN_OPTIONS": _SYMBOLIZER + ":fast_unwind_on_malloc=0",
    "LSAN_OPTIONS": _SYMBOLIZER + ":suppressions=$(rootpath lsan_suppressions.txt)",
    "TSAN_OPTIONS": _SYMBOLIZER,
    "UBSAN_OPTIONS": _SYMBOLIZER + ":print_stacktrace=1",
}

# One test per *_test.cpp file, named after it.
[cc_test(
    name = src.removesuffix(".cpp"),
    size = "small",
    srcs = [src],
    data = [
        "lsan_suppressions.txt",
        "@llvm_toolchain_llvm//:symbolizer",
    ],
    env = _SANITIZER_ENV,
    deps = [
        ":phy",
        ":test_util",
        "@googletest//:gtest_main",
    ],
) for src in glob(["*_test.cpp"])]
