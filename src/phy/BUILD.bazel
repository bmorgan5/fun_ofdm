load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/sanitizers:sanitizers.bzl", "SANITIZER_DATA", "SANITIZER_ENV")

# The overview of the PHY, for the API documentation.
exports_files(["README.md"])

# The 802.11a PHY: building frames into samples and receiving frames from
# samples. Pure DSP, with no UHD dependency, so tests and benchmarks can use it
# without a USRP.
cc_library(
    name = "phy",
    srcs = glob(
        ["*.cpp"],
        exclude = ["*_test.cpp"],
    ),
    hdrs = glob(
        ["*.h"],
        exclude = ["test_util.h"],
    ),
    # The Viterbi decoder uses SSE intrinsics, through sse2neon on aarch64.
    copts = select({
        "@platforms//cpu:x86_64": [
            "-mssse3",
            "-msse4.1",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//src:__subpackages__"],
    deps = ["//third_party:fftw3"] + select({
        "@platforms//cpu:aarch64": ["@sse2neon"],
        "//conditions:default": [],
    }),
)

# Helpers shared by the tests.
cc_library(
    name = "test_util",
    testonly = True,
    hdrs = ["test_util.h"],
    visibility = ["//src:__subpackages__"],
    deps = [
        ":phy",
        "@googletest//:gtest",
    ],
)

# One test per *_test.cpp file, named after it.
[cc_test(
    name = src.removesuffix(".cpp"),
    size = "small",
    srcs = [src],
    # The sysroot is for running under qemu (tools/qemu).
    data = ["//third_party:sysroot"] + SANITIZER_DATA,
    env = SANITIZER_ENV,
    deps = [
        ":phy",
        ":test_util",
        "@googletest//:gtest_main",
    ],
) for src in glob(["*_test.cpp"])]
