load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

exports_files(["README.md"])

# Shorthand for `bazel build fun-ofdm` / `bazel run fun-ofdm -- sim` from the
# workspace root.
alias(
    name = "fun-ofdm",
    actual = "//src:fun-ofdm",
)

pkg_files(
    name = "binaries",
    srcs = [
        ":fun-ofdm",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "bin",
)

# Copies the binaries to out/<platform>/ in the workspace, so each target
# platform gets its own directory: `bazel run install`.
pkg_install(
    name = "install",
    srcs = [":binaries"],
    destdir = select({
        "@platforms//cpu:x86_64": "out/linux_x86_64",
        # TODO(arm64): Enable once the code builds for arm64.
        # "@platforms//cpu:aarch64": "out/linux_aarch64",
    }),
)

# Shorthands for the formatter in tools/format: `bazel run format` and
# `bazel run format.check`.
alias(
    name = "format",
    actual = "//tools/format",
)

alias(
    name = "format.check",
    actual = "//tools/format:check",
)
