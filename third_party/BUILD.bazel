# System libraries, from the sysroot for the target platform.

package(default_visibility = ["//visibility:public"])

[
    alias(
        name = lib,
        actual = select({
            "@platforms//cpu:aarch64": "@sysroot_linux_aarch64//:" + lib,
            "@platforms//cpu:x86_64": "@sysroot_linux_x86_64//:" + lib,
        }),
    )
    for lib in [
        "fftw3",
        "uhd",
    ]
]
