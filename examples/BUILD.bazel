load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

[
    cc_binary(
        name = name,
        srcs = [src],
        visibility = [
            "//:__pkg__",
            "//docs:__pkg__",
        ],
        deps = ["//src:fun_ofdm"],
    )
    for name, src in {
        "receiver": "test_rx.cpp",
        "sim": "test_sim.cpp",
        "transceiver": "simple_transceiver.cpp",
        "transmitter": "test_tx.cpp",
    }.items()
]
